{
  "name": "hitl-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP server: ephemeral communication bridge between AI agents and humans",
  "type": "module",
  "bin": {
    "hitl-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "agent-rules",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hitl",
    "human-in-the-loop",
    "slack",
    "whatsapp",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@slack/socket-mode": "^3.0.1",
    "@slack/web-api": "^8.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
